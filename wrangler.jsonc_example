{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "newapp-api",
  "compatibility_date": "2026-06-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "api/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [ "/api/*" ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "newapp-database",
      "database_id": "uuid-from-cloudflare-dash",
      "migrations_dir": "lib/drizzle"
    }
  ],
  "routes": [
    {
      "pattern": "newapp.example.com",
      "custom_domain": true
    }
  ]
}
