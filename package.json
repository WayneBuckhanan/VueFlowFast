{
  "name": "new-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "db:create": "wrangler d1 create vff-database",
    "db:migrate": "wrangler d1 execute vff-database --file=./api/schema.sql",
    "db:migrate:local": "wrangler d1 execute vff-database --local --file=./api/schema.sql"
  },
  "allowScripts": {
    "@tailwindcss/oxide@4.1.10": true,
    "esbuild@0.25.4": true,
    "sharp@0.33.5": true,
    "workerd@1.20250617.0": true
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.7.4",
    "@cloudflare/workers-types": "^4.20250620.0",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify/tailwind4": "^1.2.3",
    "@primeuix/themes": "^2.0.3",
    "@primevue/auto-import-resolver": "^4.5.5",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "hono": "^4.8.2",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "primevue": "^4.5.5",
    "pug": "^3.0.4",
    "tailwindcss": "^4.3.0",
