{
  "name": "new-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "admin:add": "npx wrangler d1 execute DB --command \"update users set role='admin' where email='your-admin-user@gmail.com'\"",
    "check:users": "npx wrangler d1 execute DB --command \"select * from users\"",
    "check:crudl": "npx wrangler d1 execute DB --command \"select * from crudl_items\"",
    "check:tables": "npx wrangler d1 execute DB --command \"PRAGMA table_list\"",
    "db:create": "wrangler d1 create DB",
    "db:better-auth:schema": "npx auth generate --config ./lib/auth.ts --output ./lib/auth-schema.ts --yes",
    "db:better-auth:generate": "drizzle-kit generate",
    "db:better-auth:migrate": "wrangler d1 migrations apply DB",
    "db:better-auth:all": "npm run db:better-auth:schema && npm run db:better-auth:generate && npm run db:better-auth:migrate",
    "db:better-auth:migrate-remote": "npm run db:better-auth:migrate -- --remote",
    "db:better-auth:all-remote": "npm run db:better-auth:schema && npm run db:better-auth:generate && npm run db:better-auth:migrate-remote",
    "db:crudl:init": "wrangler d1 execute DB --file=./api/crudl/sql/init.sql",
    "db:crudl:load-demo": "wrangler d1 execute DB --file=./api/crudl/sql/demo-data.sql",
    "deploy": "export CLOUDFLARE_ENV=production; npm run build && wrangler deploy --env=production"
  },
  "allowScripts": {
    "@tailwindcss/oxide": true,
    "esbuild": true,
    "sharp": true,
    "workerd": true
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.42.1",
    "@cloudflare/workers-types": "^4.20260621.1",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify/tailwind4": "^1.2.3",
    "@primeuix/themes": "^2.0.3",
    "@primevue/auto-import-resolver": "^4.5.5",
    "@tailwindcss/vite": "^4.3.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "better-auth": "^1.6.20",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.26",
    "mande": "^2.0.9",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "primevue": "^4.5.5",
    "pug": "^3.0.4",
    "tailwindcss": "^4.3.1",
    "tailwindcss-primeui": "^0.6.1",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.16",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0",
    "wrangler": "^4.103.0"
  }
}
