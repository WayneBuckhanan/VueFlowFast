{
  "name": "new-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "db:create": "wrangler d1 create vff-database",
    "db:migrate": "wrangler d1 execute vff-database --file=./api/schema.sql",
    "db:migrate:local": "wrangler d1 execute vff-database --local --file=./api/schema.sql",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:api": "vitest run tests/api.test.js",
    "test:auth": "vitest run tests/auth.test.js",
    "test:database": "vitest run tests/database.test.js"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.7.4",
    "@cloudflare/vitest-pool-workers": "^0.8.43",
    "@cloudflare/workers-types": "^4.20250620.0",
    "@primeuix/themes": "^1.1.2",
    "@primevue/auto-import-resolver": "^4.3.5",
    "@tailwindcss/vite": "^4.1.10",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "hono": "^4.8.2",
    "pinia": "^3.0.3",
    "primeicons": "^7.0.0",
    "primevue": "^4.3.5",
    "pug": "^3.0.3",
    "tailwindcss": "^4.1.10",
    "tailwindcss-primeui": "^0.6.1",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-vue-components": "^28.7.0",
    "unplugin-vue-router": "^0.12.0",
    "uuid": "^11.1.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1",
    "wrangler": "^4.20.5"
  }
}
